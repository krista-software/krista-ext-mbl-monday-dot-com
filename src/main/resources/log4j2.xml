<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="app.krista.extensions.essentials.collaboration.mblmondaydotcom" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <!-- okhttp wire logging stays OFF: request/response bodies would carry the Authorization header. -->
        <Logger name="okhttp3" level="warn" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Root level="warn">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
